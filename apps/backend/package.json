{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "pnpm --filter @farmatodo-retail-media/types build && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed": "ts-node scripts/seed.ts",
    "reset": "ts-node scripts/reset.ts",
    "reset:full": "ts-node scripts/reset-and-seed.ts",
    "set-claim": "ts-node scripts/set-role-claim.ts"
  },
  "dependencies": {
    "@farmatodo-retail-media/types": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
