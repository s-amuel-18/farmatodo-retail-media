rules_version = '2';

// Deny-by-default: nothing is readable or writable unless explicitly allowed
// below. All writes to `campaigns` go through the NestJS backend (Admin SDK,
// which bypasses these rules entirely) — the rules here only cover what a
// signed-in client could try to do by talking to Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isOwner(resource) {
      return resource.data.createdBy == request.auth.uid;
    }

    match /campaigns/{campaignId} {
      allow read: if isSignedIn() &&
        (role() == 'APPROVER_MANAGER' || (role() == 'COMMERCIAL_ANALYST' && isOwner(resource)));

      // No direct client writes — every mutation must go through the backend,
      // which is what actually validates the state machine and RBAC.
      allow write: if false;

      match /history/{historyId} {
        allow read: if isSignedIn() &&
          (role() == 'APPROVER_MANAGER' ||
            (role() == 'COMMERCIAL_ANALYST' && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.createdBy == request.auth.uid));
        allow write: if false;
      }
    }

    match /mediaCosts/{costId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /brands/{brandId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /products/{sku} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
